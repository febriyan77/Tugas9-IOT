    {
        "id": "b0bdd6e44f512a0f",
        "type": "function",
        "z": "4ee931fdffee95bb",
        "name": "format DB",
        "func": "// Kita ambil data asli\nvar suhuVal = msg.payload.suhu;\nvar kelembabanVal = msg.payload.kelembaban;\n\n// 1. Buat pesan untuk SQLITE\nvar msgDB = {\n    topic: \"INSERT INTO log_sensor (suhu, kelembaban) VALUES (?, ?)\",\n    payload: [suhuVal, kelembabanVal]\n};\n\n// 2. Buat pesan untuk WEB\nvar msgWeb = {\n    payload: {\n        suhu: suhuVal,\n        kelembaban: kelembabanVal\n    }\n};\n\nreturn [msgDB, msgWeb];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
